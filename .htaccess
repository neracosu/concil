# CONCIL · concil.app — configuración del dominio
# La aplicación vive en la raíz del dominio desde el 20/09/2026. Antes estaba
# en una carpeta de vipsoft.cloud y las reglas de más abajo llevaban esa ruta
# por delante; escritas así ya no protegían nada al mudarse.

RewriteEngine On
# Todo por HTTPS y sin www. Se deja fuera la carpeta con la que AutoSSL
# renueva el certificado: si la redirige, la renovación puede fallar.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://concil.app/$1 [R=301,L]

# Sin listados de directorio
Options -Indexes
DirectoryIndex index.php

# El código de lib/ y de views/ nunca se sirve directamente
# (además cada carpeta tiene su propio .htaccess que lo deniega).
RedirectMatch 404 ^/(lib|views)/.*$

# Ni el repositorio ni la documentación se sirven por web. El `.git` deja
# reconstruir todo el código commit a commit, y CLAUDE.md cuenta dónde viven
# los datos y cómo funciona la sesión.
RedirectMatch 404 ^/\.git(/.*)?$

<FilesMatch "^\.git(ignore|attributes)$|\.(md|sql|gz|log|bak)$">
  Require all denied
</FilesMatch>

# Ningún extracto bancario se sirve por web, esté donde esté. Los archivos del
# banco van en DATA_DIR, fuera de public_html; esto es la red de seguridad para
# cuando alguien deja una copia aquí sin darse cuenta.
<FilesMatch "\.(xlsx|xls|csv|ods|qif|ofx|mt940|sta)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  # Empieza en un día a propósito. Se sube a un año cuando lleve dos semanas
  # sin sobresaltos: un plazo largo deja el sitio inalcanzable si el
  # certificado falla.
  Header always set Strict-Transport-Security "max-age=86400"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>


# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
